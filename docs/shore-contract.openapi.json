{
  "openapi": "3.1.0",
  "info": {
    "title": "Spoke ↔ Shore integration",
    "version": "1.0.0",
    "description": "Machine-readable version of docs/shore-contract.md, which explains the rules (signing, retries, ordering). Paths are relative to each operation's server. Consumers must ignore response fields they don't know: new optional fields can be added within v1."
  },
  "servers": [
    {
      "url": "{spokeBaseUrl}/integrations/shore/v1/{organizationId}",
      "variables": {
        "spokeBaseUrl": {
          "default": "https://spoke.example.org"
        },
        "organizationId": {
          "default": "1",
          "description": "The Spoke organization ID."
        }
      }
    }
  ],
  "security": [
    {
      "shoreTimestamp": [],
      "shoreSignature": []
    }
  ],
  "tags": [
    {
      "name": "Shore implements (Spoke calls)",
      "description": "Served by Shore under {SHORE_URL}/api/spoke/v1/{campaign}."
    },
    {
      "name": "Spoke implements (Shore calls)",
      "description": "Served by Spoke's shore extension under /integrations/shore/v1/{organizationId}."
    }
  ],
  "paths": {
    "/segments": {
      "get": {
        "tags": [
          "Shore implements (Spoke calls)"
        ],
        "operationId": "listSegments",
        "summary": "List the campaign's segments for Spoke's picker",
        "responses": {
          "200": {
            "description": "Segments.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentList"
                }
              }
            }
          },
          "401": {
            "description": "Bad signature. Spoke shows 'Shore rejected the request'.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "servers": [
        {
          "url": "{shoreUrl}/api/spoke/v1/{campaign}",
          "variables": {
            "shoreUrl": {
              "default": "https://app.shore.example",
              "description": "SHORE_URL, including any path prefix."
            },
            "campaign": {
              "default": "gotv-2026",
              "description": "SHORE_CAMPAIGN"
            }
          }
        }
      ]
    },
    "/segments/{segmentId}/loads": {
      "post": {
        "tags": [
          "Shore implements (Spoke calls)"
        ],
        "operationId": "startLoad",
        "summary": "Start a load: snapshot the segment's textable contacts",
        "parameters": [
          {
            "name": "segmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartLoadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Load started. Same spokeJobId → same loadId.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartLoadResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown segment. Spoke reports segment_not_found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "servers": [
        {
          "url": "{shoreUrl}/api/spoke/v1/{campaign}",
          "variables": {
            "shoreUrl": {
              "default": "https://app.shore.example",
              "description": "SHORE_URL, including any path prefix."
            },
            "campaign": {
              "default": "gotv-2026",
              "description": "SHORE_CAMPAIGN"
            }
          }
        }
      ]
    },
    "/loads/{loadId}/contacts": {
      "get": {
        "tags": [
          "Shore implements (Spoke calls)"
        ],
        "operationId": "getLoadContacts",
        "summary": "One page of a load's snapshot",
        "parameters": [
          {
            "name": "loadId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Omitted on the first page."
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            },
            "description": "Return at most this many contacts. Spoke asks for 1000 or fewer."
          }
        ],
        "responses": {
          "200": {
            "description": "A page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactPage"
                }
              }
            }
          },
          "404": {
            "description": "Unknown load. Spoke reports load_expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Expired load. Spoke reports load_expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "servers": [
        {
          "url": "{shoreUrl}/api/spoke/v1/{campaign}",
          "variables": {
            "shoreUrl": {
              "default": "https://app.shore.example",
              "description": "SHORE_URL, including any path prefix."
            },
            "campaign": {
              "default": "gotv-2026",
              "description": "SHORE_CAMPAIGN"
            }
          }
        }
      ]
    },
    "/opt-outs": {
      "post": {
        "tags": [
          "Spoke implements (Shore calls)"
        ],
        "operationId": "postOptOuts",
        "summary": "Opt numbers out in Spoke",
        "description": "Content-Type MUST be application/vnd.shore+json. Each number is opted out through Spoke's own STOP path. Idempotent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.shore+json": {
              "schema": {
                "$ref": "#/components/schemas/OptOutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "All cells handled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptOutResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json | cells_required | cells_count | invalid_reason",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "unsupported_media_type: Content-Type isn't application/vnd.shore+json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "failed > 0 (retry the whole request), or internal_error.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OptOutResponse"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Spoke implements (Shore calls)"
        ],
        "operationId": "listOptOuts",
        "summary": "Opt-outs recorded in Spoke",
        "description": "Rows with id > afterId in this organization, ascending. Rows created less than SHORE_SETTLE_SECONDS (default 15) ago are held back, and the page stops at the first such row, so a short or empty page means 'caught up for now', not 'no more rows ever'. A full page (length == limit) means more may be ready immediately. With OPTOUTS_SHARE_ALL_ORGS set in Spoke, includes every organization's opt-outs.",
        "parameters": [
          {
            "name": "afterId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "default": 500
            },
            "description": "Values above 2000 are treated as 2000."
          }
        ],
        "responses": {
          "200": {
            "description": "A page in ascending id order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptOutsPage"
                }
              }
            }
          },
          "400": {
            "description": "invalid_paging",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: bad, stale or missing signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: unknown organization, or Shore not configured for it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "internal_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "servers": [
        {
          "url": "{spokeBaseUrl}/integrations/shore/v1/{organizationId}",
          "variables": {
            "spokeBaseUrl": {
              "default": "https://spoke.example.org"
            },
            "organizationId": {
              "default": "1",
              "description": "The Spoke organization ID."
            }
          }
        }
      ]
    },
